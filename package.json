{
  "name": "flex-book",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.0",
    "date-fns": "^4.4.0",
    "expo": "~57.0.25",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.23",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "nativewind": "^4.2.7",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.89.0",
    "react-native": "0.86.3",
    "react-native-css-interop": "^0.2.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "lint": "expo lint src e2e playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test -- --ci",
    "e2e": "npm run build:web && playwright test",
    "e2e:report": "playwright show-report",
    "openapi": "UPDATE_OPENAPI=1 jest src/api/__tests__/openapi.test.ts",
    "seed:export": "UPDATE_FIXTURES=1 jest src/api/__tests__/seed-fixtures.test.ts"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/backend/",
      "/dist/",
      "/e2e/"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/jest/style-stub.js",
      "^expo-camera$": "<rootDir>/jest/expo-camera-mock.js"
    }
  }
}
